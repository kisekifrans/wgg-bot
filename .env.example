# =============================================================================
# BOT ONLY — copy to `.env` in this folder (repo root)
# Used by: Fly.io / `npm start` at repo root
# NOT used by the Vercel web dashboard (see dashboard/.env.local.example)
# =============================================================================

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_server_guild_id_here
STAFF_ROLE_ID=staff_role_id_here

# Discord Category ID per ticket type
CATEGORY_ACCOUNT_ID=discord_category_id_for_account_tickets
CATEGORY_BOOSTING_ID=discord_category_id_for_boosting_tickets
CATEGORY_UNBAN_ID=discord_category_id_for_unban_tickets
CATEGORY_RELINK_ID=discord_category_id_for_relink_tickets
CATEGORY_PREDATOR_ID=discord_category_id_for_predator_tickets

# Legacy static dashboard (old password UI — do NOT use with Supabase + Vercel)
DASHBOARD_PORT=3847
DASHBOARD_PASSWORD=change-this-password
START_LEGACY_DASHBOARD=false

# Supabase — bot reads/writes panels, commands, ticket counter
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -----------------------------------------------------------------------------
# Web dashboard (Next.js on Vercel / local `cd dashboard && npm run dev`)
# → Use dashboard/.env.local.example instead (different variable names!)
# -----------------------------------------------------------------------------

# =============================================================================
# WEB DASHBOARD ONLY — copy to `dashboard/.env.local`
# Used by: Vercel (set same names in Project → Environment Variables)
#          Local: `cd dashboard && npm run dev`
# NOT the same file as repo root `.env` (that one is for the Discord bot)
# =============================================================================

# Supabase → Settings → API
# URL + anon key are public (embedded in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# service_role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Discord — for checking guild owner/admin after login
DISCORD_BOT_TOKEN=your_bot_token
GUILD_ID=your_guild_id

# Optional: allow specific Discord user IDs (comma-separated) besides owner/admin
# ALLOWED_DISCORD_IDS=123456789,987654321

# -----------------------------------------------------------------------------
# Copy values from repo root `.env` (same project, different names):
#
#   NEXT_PUBLIC_SUPABASE_URL     ←  SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY ←  Supabase dashboard → API → anon (not in bot .env)
#   SUPABASE_SERVICE_ROLE_KEY    ←  SUPABASE_SERVICE_ROLE_KEY
#   DISCORD_BOT_TOKEN            ←  DISCORD_TOKEN
#   GUILD_ID                     ←  GUILD_ID
#
# Vercel: Root Directory must be `dashboard`, then add all vars above and redeploy.
# -----------------------------------------------------------------------------

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase service role (server only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Discord bot token (server only — for verifying guild owner/admin)
DISCORD_BOT_TOKEN=your_bot_token
GUILD_ID=your_guild_id

# Optional: allow specific Discord user IDs (comma-separated) besides owner/admin
# ALLOWED_DISCORD_IDS=123456789,987654321
